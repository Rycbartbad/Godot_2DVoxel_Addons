# ---------------------------------------------------------------- Godot
# 导入缓存：完全可再生，而且体积不小
.godot/
# 导出产物
/build/
/export/
*.translation

# ---------------------------------------------------------------- 构建产物
# ⚠️ addons/pixel_destruction/ 是 **生成物**（由 tools/build_addon.py 从
# src/ + gdext/ + addon_src/ 拼出来），不进仓库 —— 否则就有两个真源。
# CI 会构建、校验并打包发布，见 .github/workflows/ci.yml。
addons/pixel_destruction/
pixel_destruction*.zip
# ⚠️ Windows 的 fastphys.dll **提交进仓库**（0.5 MB）：
#   没有它就只能走 GDScript 回退路径，而回退路径目前与原生路径**不等价**
#   （实测 sleep_box 0/12 -> 10/12 清醒）。开箱可用比"仓库里不放二进制"更重要。
#   源码在 gdext/，改了就重新编译并一起提交。
#   其它平台/中间产物不提交：
gdext/*.so
gdext/*.dylib
# 链接器的临时备份文件（g++ 会留下 ~<name>.dll）
gdext/~*
gdext/*.dylib
gdext/*.o
gdext/*.obj
gdext/*.exe
addons/pixel_destruction/native/*.dll
addons/pixel_destruction/native/*.so
# 打包产物：addon 目录本身就是可用的，再打个 zip 只会产生第二个真源
addons/*.zip

# 测试夹具：由脚本生成，不进仓库（省 5 MB）
#   collide_pairs.bin  <- tests/dump_collide_bin.gd
#   batch.bin          <- tests/dump_batch_bin.gd
gdext/*.bin

# ---------------------------------------------------------------- Godot 生成物
# 这两个由 godot --dump-extension-api 生成，合计 6.6 MB
extension_api.json
gdextension_interface.h

# 演示截图：由 -- --shot 生成
demo_shot.png
demo_shot.png.import

# ---------------------------------------------------------------- 调研资料
# _research/ 是第三方仓库的拷贝（含一个 84 MB 的 .vox），_tdres/ 是下载的参考资料。
# 两者都不属于本项目源码，而且提交第三方内容有许可问题。
_research/
_tdres/

# ---------------------------------------------------------------- 杂项
*.tmp
*.log
Thumbs.db
Desktop.ini
.DS_Store
